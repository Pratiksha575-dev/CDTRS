# ==============================================================================
# CDTRS FastAPI Backend - Environment Configuration Template
# Copy this file to .env in the backend/ directory: copy .env.example .env
# ==============================================================================

# Database Connection String
# PostgreSQL format: postgresql+psycopg2://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:nmrl@localhost:5432/cdtrs

# Server Host & Port
# Use 0.0.0.0 to allow access from other PCs on the local network (LAN)
HOST=0.0.0.0
PORT=8000

# Security & Token Settings
SECRET_KEY=cdtrs-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# CORS Allowed Origins (* for all, or comma-separated list of origins)
CORS_ORIGINS=*
