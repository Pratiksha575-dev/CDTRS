# ==============================================================================
# CDTRS - Configuration & Environment Settings (.env)
# ==============================================================================

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cdtrs_db
# For SQLite (optional):
# DATABASE_URL=sqlite:///./cdtrs.db

# Storage Directory for Uploaded Document PDFs & Attachments
UPLOAD_DIR=./uploads

# Secret key for JWT session tokens
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# MAIL INTEGRATION MODE SWITCH
# ------------------------------------------------------------------------------
# Choose how CDTRS syncs emails and dispatches workflow notices/reminders:
# Options:
#   1. "outlook"  -> Cloud Outlook via Microsoft Graph API (Requires Internet)
#   2. "intranet" -> Local LAN Mail via standard IMAP & SMTP (100% Offline / No Internet)
# ==============================================================================
MAIL_CHANNEL=outlook


# ------------------------------------------------------------------------------
# MODE A: CLOUD OUTLOOK CONFIGURATION (MAIL_CHANNEL=outlook)
# ------------------------------------------------------------------------------
# Used for personal Outlook (@outlook.com / @hotmail.com) or Microsoft 365.
# Run 'python backend/mail/auth_personal.py' once to generate .token_cache.json.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_MAILBOX=pratiksha@outlook.com


# ------------------------------------------------------------------------------
# MODE B: INTRANET / LOCAL OFFICE LAN MAIL (MAIL_CHANNEL=intranet)
# ------------------------------------------------------------------------------
# Works 100% offline over Local Area Network (No public internet needed).
# Compatible with internal Exchange on-prem, NIC Gov Mail, Postfix, Dovecot, or hMailServer.

# IMAP Settings (For DS Inbox incoming email & PDF attachment sync over LAN):
INTRANET_IMAP_HOST=192.168.1.100
INTRANET_IMAP_PORT=993
INTRANET_IMAP_SSL=true

# SMTP Settings (For outgoing reminders & routing notices over LAN):
INTRANET_SMTP_HOST=192.168.1.100
INTRANET_SMTP_PORT=587
INTRANET_SMTP_SSL=false
INTRANET_SMTP_STARTTLS=true

# Local Mailbox Credentials:
INTRANET_MAIL_USER=ds_office@intranet.gov.in
INTRANET_MAIL_PASS=your_local_password
INTRANET_SENDER_EMAIL=ds_office@intranet.gov.in
INTRANET_SENDER_NAME=CDTRS Directorate Secretary

# Set to true if local office mail server uses a self-signed SSL certificate:
INTRANET_ALLOW_SELFSIGNED=true
